{
  "name": "nbn-signup-agent",
  "version": "1.0.0",
  "description": "AI agent for the Tangerine NBN sign-up journey with self-healing and isolated card payment",
  "scripts": {
    "job": "tsx src/index.ts",
    "new-job": "tsx scripts/new-job.ts",
    "leak-check": "tsx src/security/leak-check.ts",
    "recon": "tsx scripts/recon.ts",
    "codegen": "playwright codegen --target=javascript -o recon/codegen.js https://test-tangerine.hipeely.com/nbn/nbn-broadband#speeds",
    "typecheck": "tsc --noEmit",
    "heal:reset": "node -e \"require('fs').rmSync('heal-memory/tangerine.json',{force:true})\"",
    "test": "tsx --test --test-concurrency=1 tests/offline.test.ts"
  },
  "keywords": [],
  "author": "chamanluthiya@gmail.com",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.7",
    "openai": "^7.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
