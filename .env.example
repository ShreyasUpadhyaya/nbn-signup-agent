# Copy to .env and fill in. .env is gitignored.

# Model provider for L2/L3 healing. Only redacted page views are ever sent to it.
# openai (OPENAI_API_KEY) or gemini (GEMINI_API_KEY, default model gemini-3.5-flash-lite)
MODEL_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
MODEL_NAME=

# Absolute path to the test-card vault stub, kept OUTSIDE this repo.
# Example: C:\Users\<you>\.nbn-agent\vault.json
VAULT_PATH=

# Optional: path to the job payload (the run command also accepts it as an argument)
JOB_PAYLOAD=payloads/sample-job.json
